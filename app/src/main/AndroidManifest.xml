<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Installing updates downloaded from the project's GitHub releases; Android always asks first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Shoal takes over updates when it is installed. -->
    <queries>
        <package android:name="io.github.shoalapps.shoal" />
    </queries>

    <!-- Reading the Tintloom version's data once, after the rename. Signature-only: both apps share the release key. -->
    <permission
        android:name="io.github.shoalapps.permission.MOVE_DATA"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.shoalapps.permission.MOVE_DATA" />
    <queries>
        <provider android:authorities="io.github.tintloom.social.movedata" />
        <provider android:authorities="io.github.tintloom.social.debug.movedata" />
        <package android:name="io.github.tintloom.social" />
    </queries>

    <!-- Accounts from Shoal (signature-protected). -->
    <uses-permission android:name="io.github.shoalapps.permission.ACCOUNTS" />
    <queries>
        <provider android:authorities="io.github.shoalapps.shoal.accounts" />
        <provider android:authorities="io.github.shoalapps.shoal.debug.accounts" />
    </queries>

    <application
        android:name=".SocialApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Social"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bsky.app" android:pathPrefix="/profile/" />
            </intent-filter>
            <!-- Bluesky's sign-in page sends you back here (AT Protocol OAuth). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.github.shoalapps" android:path="/oauth/blobfish" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.InstallResultReceiver"
            android:exported="false" />
        <!-- Home-screen widget. -->
        <receiver android:name=".widget.BlobfishWidgetReceiver" android:exported="false" android:label="Blobfish">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <!-- Error reports start only with consent (Telemetry.kt). -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
    </application>
</manifest>
